# UWSM sources this file as shell code and exports these settings to session apps.
# UWSM/the display manager supplies session identity; toolkit backends auto-select
# Wayland with X11 fallback, avoiding GTK 4 and X11-only app regressions.
# Use qt6ct so Qt applications read the palette generated by Noctalia's Qt template.
export QT_QPA_PLATFORMTHEME=qt6ct

# Keep the chosen cursor consistent across Wayland applications.
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# Opt in to native Wayland for Firefox; remove this if Firefox has display issues.
export MOZ_ENABLE_WAYLAND=1
